{
  "name": "muy-rico-cr-business-card",
  "version": "0.0.11",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "standalone:prepare": "rm -rf .next/standalone/public .next/standalone/.next/static && mkdir -p .next/standalone/public .next/standalone/.next/static && cp -a public/. .next/standalone/public/ && cp -a .next/static/. .next/standalone/.next/static/",
    "build": "DEPLOY=false next build && npm run standalone:prepare",
    "deploy": "DEPLOY=true next build && npm run standalone:prepare",
    "deploypack": "npm run deploy && tar -czf ./muyrico_bc_${npm_package_version}_$(date +\"%Y%m%d\").tar.gz -C .next/standalone .",
    "start": "node .next/standalone/server.js",
    "lint": "next lint",
    "pp": "npx prettier src/ --check --parser=\"typescript\" --ignore-path=.prettierignore",
    "ppf": "npx prettier --write --parser=\"typescript\""
  },
  "dependencies": {
    "@next/third-parties": "^15.5.27",
    "@types/node": "^22.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "^15.5.27",
    "next-intl": "^4.14.9",
    "polished": "^4.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "styled-components": "^6.5.3",
    "typescript": "^5.6.3"
  },
  "devDependencies": {
    "eslint": "8.57.1",
    "eslint-config-next": "^15.5.27",
    "prettier": "^3.3.3",
    "prettier-plugin-sort-react-imports": "^0.5.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.13": true
  }
}
